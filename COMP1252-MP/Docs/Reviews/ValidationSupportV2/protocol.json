  "rule": {
    "audit_universe": "Every frozen validation candidate pair, and every anchor of every validation pair with completed published QA; no area, bounding-size, top-three or quality-status filter before auditing.",
    "unreviewed_candidates": "Retain unscreened/blocked candidate pairs with explicit status and no fabricated pixel counts.",
    "erosion_pixels": 1,
    "minimum_interior_pixels": 4,
    "require_automatic_pass": true,
    "require_zero_endpoint_crop_and_target_qa": true,
    "require_zero_actual_interior_qa": true,
    "require_full_footprint_isolation": true,
    "require_later_metadata_usable_scene": true,
    "followup_window_days": 45,
    "followup_same_year": true,
    "exclude_prior_events": true,
    "exclude_prior_groups": true,
    "source_strata": [
      "36UXA_time-dependent",
      "36UYA_Summer_time-dependent",
      "36UYA_Spring_time-dependent"
    ],
    "primaries_per_stratum": 1,
    "alternates_per_stratum_at_most": 1,
    "maximum_shortlist": 6,
    "ranking": [
      "group_id",
      "event_id",
      "post_date_not_annotation_date",
      "interval_days",
      "pair_id"
    ],
    "ranking_uses_ndvi_or_model_scores": false,
    "shortlist_approves_labels": false,
    "new_imagery_reviewed": false,
    "no_fallback_when_slots_missing": true,
    "cache_policy": "Final target/interior depend on pair dates and temporal reference; never cache by event/grid alone."
  },
  "resources": {
    "workers": 1,
    "native_threads": 1,
    "gpu_used": false,
    "nice_increment": 10,
    "worker_rss_mib": 512,
    "available_memory_reserve_gib": 1.5,
    "max_seconds_per_worker": 300,
    "maximum_validation_pairs": 2000,
    "maximum_anchor_records": 10000
  },
  "limitations": [
    "Geometry support is not a visual forest/clearing label or proof of temporal transition.",
    "Clear-image and support filters create convenience-sample bias.",
    "Previously exposed review groups are excluded to preserve fresh review; all their audited rows and reasons remain retained.",
    "The audit counts anchor geometry and temporal clipping separately; limited support is not necessarily caused only by polygon width.",
    "No satellite JP2 pixels, model execution, training, new image previews or accuracy scores are authorized in this audit milestone."
  ]
